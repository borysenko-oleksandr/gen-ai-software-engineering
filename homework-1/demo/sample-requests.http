### Banking Transactions API — Sample Requests
### Use with VS Code REST Client extension or import into Postman

@baseUrl = http://localhost:3000

###
# Health check
GET {{baseUrl}}/

###
# Create a deposit
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "toAccount": "ACC-12345",
  "amount": 1000.00,
  "currency": "USD",
  "type": "deposit"
}

###
# Create another deposit
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "toAccount": "ACC-67890",
  "amount": 500.00,
  "currency": "USD",
  "type": "deposit"
}

###
# Create a transfer
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "fromAccount": "ACC-12345",
  "toAccount": "ACC-67890",
  "amount": 250.50,
  "currency": "USD",
  "type": "transfer"
}

###
# Create a withdrawal
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "fromAccount": "ACC-67890",
  "amount": 100.00,
  "currency": "USD",
  "type": "withdrawal"
}

###
# Create transaction in EUR
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "fromAccount": "ACC-12345",
  "toAccount": "ACC-ABCDE",
  "amount": 75.25,
  "currency": "EUR",
  "type": "transfer"
}

###
# Validation error — invalid amount
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "toAccount": "ACC-12345",
  "amount": -50,
  "currency": "USD",
  "type": "deposit"
}

###
# Validation error — bad account format
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "fromAccount": "ACCOUNT-123",
  "toAccount": "ACC-67890",
  "amount": 100,
  "currency": "USD",
  "type": "transfer"
}

###
# Get all transactions
GET {{baseUrl}}/transactions

###
# Filter by account
GET {{baseUrl}}/transactions?accountId=ACC-12345

###
# Filter by type
GET {{baseUrl}}/transactions?type=transfer

###
# Filter by date range
GET {{baseUrl}}/transactions?from=2024-01-01&to=2024-12-31

###
# Combine filters
GET {{baseUrl}}/transactions?accountId=ACC-12345&type=transfer

###
# Get transaction by ID (replace with real ID from response above)
GET {{baseUrl}}/transactions/replace-with-real-id

###
# Get account balance
GET {{baseUrl}}/accounts/ACC-12345/balance

###
# Get account balance for another account
GET {{baseUrl}}/accounts/ACC-67890/balance

###
# Get account summary (Option A — bonus feature)
GET {{baseUrl}}/accounts/ACC-12345/summary

###
# Get account not found
GET {{baseUrl}}/accounts/ACC-99999/balance
